# OpenAI (server only — never commit real values)
OPENAI_API_KEY=sk-...
OPENAI_VECTOR_STORE_ID=vs_...
OPENAI_MODEL=gpt-4o-mini
OPENAI_FILE_SEARCH_MAX_RESULTS=10

# Helpers: local = search the Canon documents in /canon (default).
# The reader book is part of the Canon, not the Canon itself.
# openai / auto = OpenAI File Search (only after the 22 Canon files are uploaded).
HELPERS_BACKEND=local

# Folder of source .docx for: npm run extract-canon
# CANON_DIR=C:\Users\jfeld\Downloads\КАНОН_ЧИСТЫЙ_22_файла\КАНОН

# CORS for API on a separate host (GitHub Pages + Vercel API).
# Comma-separated origins, or * for any. Leave empty when book and API share one origin.
ALLOWED_ORIGINS=http://localhost:8787,https://jfeldman777.github.io

# Local dev server port
PORT=8787

# scripts/test-oracle.mjs — optional override
# ORACLE_API_URL=http://localhost:8787
